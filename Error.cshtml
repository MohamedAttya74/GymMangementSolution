<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav>
            <div class="nav-left">
                <a asp-page="/Index">Home</a>
            </div>
            <div class="nav-right">
                <a asp-page="/Privacy">Privacy</a>
            </div>
        </nav>
    </header>
    <div class="container">
        <main>
            <h1>An error occurred.</h1>
            <p>@Html.Raw(ViewData["ErrorMessage"] ?? "")</p>
        </main>
    </div>
    <footer>
        <p>&copy; 2023 - My Razor Pages App</p>
    </footer>
    <script src="~/js/site.js"></script>
</body>
</html>